{
  "name": "chemical-recipe-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Chemical Recipe Management System monorepo",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev --workspace @crms/api\" \"npm run dev --workspace @crms/web\"",
    "dev:api": "npm run dev --workspace @crms/api",
    "dev:web": "npm run dev --workspace @crms/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "seed": "npm run seed --workspace @crms/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
